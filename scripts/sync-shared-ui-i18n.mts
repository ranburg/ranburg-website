function mergeShared(locale: string) {
  const path = join("messages", locale, "tools.ui.json");
  const data = JSON.parse(readFileSync(path, "utf8")) as Record<string, unknown>;
  const existing = (data._shared as Record<string, string>) || {};
  const localeMap = locale === "en" ? {} : translations[locale] || {};
  const merged: Record<string, string> = { ...existing };
  for (const [k, v] of Object.entries(sharedEn)) {
    merged[k] = localeMap[k] ?? existing[k] ?? v;
  }
  data._shared = merged;
  writeFileSync(path, JSON.stringify(data, null, 2) + "\n");
  console.log("synced", locale, Object.keys(merged).length, "shared keys");
}

for (const locale of LOCALES) mergeShared(locale);

