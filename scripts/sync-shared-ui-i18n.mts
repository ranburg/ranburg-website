function walkTsx(dir: string, out: string[] = []) {
  for (const name of readdirSync(dir, { withFileTypes: true })) {
    const p = join(dir, name.name);
    if (name.isDirectory()) walkTsx(p, out);
    else if (name.name.endsWith(".tsx")) out.push(p);
  }
  return out;
}

let patched = 0;
for (const file of walkTsx("src/components/tools")) {
  let src = readFileSync(file, "utf8");
  if (!src.includes("useToolUi")) continue;
  let next = src;
  for (const [re, rep] of replacements) next = next.replace(re, rep);
  if (next !== src) {
    writeFileSync(file, next);
    patched++;
    console.log("patched labels", file);
  }
}
console.log("done. files patched:", patched);
